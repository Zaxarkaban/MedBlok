<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Кнопки диалогов в обычных окнах (настройки темы и т.д.) -->
  <Style Selector="Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2ED1B5" Offset="0"/>
        <GradientStop Color="#0A5C4E" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Button.app-dialog-secondary">
    <Setter Property="Background" Value="#243D36"/>
    <Setter Property="Foreground" Value="#D9E8E2"/>
    <Setter Property="BorderBrush" Value="#3D7A68"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="14,9"/>
  </Style>

  <Style Selector="Window.light-ui Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0D9488" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="BorderBrush" Value="#5EEAD4"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Window.light-ui Button.app-dialog-secondary">
    <Setter Property="Background" Value="#F1F5F9"/>
    <Setter Property="Foreground" Value="#334155"/>
    <Setter Property="BorderBrush" Value="#CBD5E1"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Window.space-holo-ui Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#5580C0F0" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="#F8FCFF"/>
    <Setter Property="BorderBrush" Value="#88C8F8"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Window.space-holo-ui Button.app-dialog-secondary">
    <Setter Property="Background" Value="#30283850"/>
    <Setter Property="Foreground" Value="#DCE8FF"/>
    <Setter Property="BorderBrush" Value="#6699CCE0"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Базовая (тёмная) тема -->
  <Style Selector="Window.app-dialog">
    <Setter Property="Background" Value="#0F2A24"/>
    <Setter Property="Foreground" Value="#E8F0F4"/>
    <Setter Property="FontFamily" Value="Segoe UI, Roboto, Arial"/>
  </Style>

  <Style Selector="Window.app-dialog Border.app-dialog-body">
    <Setter Property="Background" Value="#163830"/>
    <Setter Property="BorderBrush" Value="#2A6B5C"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <Style Selector="Window.app-dialog TextBlock.app-dialog-title">
    <Setter Property="Foreground" Value="#F0F8F4"/>
  </Style>

  <Style Selector="Window.app-dialog TextBlock.app-dialog-message">
    <Setter Property="Foreground" Value="#C5D5CE"/>
  </Style>

  <Style Selector="Window.app-dialog ScrollViewer">
    <Setter Property="Padding" Value="0,0,4,0"/>
  </Style>

  <Style Selector="Window.app-dialog Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2ED1B5" Offset="0"/>
        <GradientStop Color="#0A5C4E" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <Style Selector="Window.app-dialog Button.app-dialog-secondary">
    <Setter Property="Background" Value="#243D36"/>
    <Setter Property="Foreground" Value="#D9E8E2"/>
    <Setter Property="BorderBrush" Value="#3D7A68"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
    <Setter Property="Padding" Value="16,9"/>
  </Style>

  <!-- Светлая тема -->
  <Style Selector="Window.app-dialog.light-ui">
    <Setter Property="Background" Value="#F0F9FF"/>
    <Setter Property="Foreground" Value="#1E293B"/>
  </Style>

  <Style Selector="Window.app-dialog.light-ui Border.app-dialog-body">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F8FDFF" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Effect">
      <DropShadowEffect Color="#38BDF8" BlurRadius="22" OffsetX="0" OffsetY="8" Opacity="0.22"/>
    </Setter>
  </Style>

  <Style Selector="Window.app-dialog.light-ui TextBlock.app-dialog-title">
    <Setter Property="Foreground" Value="#0F4C5C"/>
  </Style>

  <Style Selector="Window.app-dialog.light-ui TextBlock.app-dialog-message">
    <Setter Property="Foreground" Value="#475569"/>
  </Style>

  <Style Selector="Window.app-dialog.light-ui Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0D9488" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="BorderBrush" Value="#5EEAD4"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="#0D9488" BlurRadius="12" OffsetX="0" OffsetY="4" Opacity="0.25"/>
    </Setter>
  </Style>

  <Style Selector="Window.app-dialog.light-ui Button.app-dialog-secondary">
    <Setter Property="Background" Value="#F1F5F9"/>
    <Setter Property="Foreground" Value="#334155"/>
    <Setter Property="BorderBrush" Value="#CBD5E1"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- Космическая тема -->
  <Style Selector="Window.app-dialog.space-holo-ui">
    <Setter Property="Background" Value="#020617"/>
    <Setter Property="Foreground" Value="#E8F0FF"/>
  </Style>

  <Style Selector="Window.app-dialog.space-holo-ui Border.app-dialog-body">
    <Setter Property="Background" Value="#28305088"/>
    <Setter Property="BorderBrush" Value="#6699CCE0"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Effect">
      <DropShadowEffect Color="#5090D8" BlurRadius="20" OffsetX="0" OffsetY="6" Opacity="0.4"/>
    </Setter>
  </Style>

  <Style Selector="Window.app-dialog.space-holo-ui TextBlock.app-dialog-title">
    <Setter Property="Foreground" Value="#F0F8FF"/>
  </Style>

  <Style Selector="Window.app-dialog.space-holo-ui TextBlock.app-dialog-message">
    <Setter Property="Foreground" Value="#C8D8F0"/>
  </Style>

  <Style Selector="Window.app-dialog.space-holo-ui Button.app-dialog-primary">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#5580C0F0" Offset="0.5"/>
        <GradientStop Color="#484878A8" Offset="1"/>
      </LinearGradientBrush>
    </Setter>
    <Setter Property="Foreground" Value="#F8FCFF"/>
    <Setter Property="BorderBrush" Value="#88C8F8"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style Selector="Window.app-dialog.space-holo-ui Button.app-dialog-secondary">
    <Setter Property="Background" Value="#30283850"/>
    <Setter Property="Foreground" Value="#DCE8FF"/>
    <Setter Property="BorderBrush" Value="#6699CCE0"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>
</Styles>
