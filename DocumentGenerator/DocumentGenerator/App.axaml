<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DocumentGenerator.App"
             xmlns:local="using:DocumentGenerator"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://DocumentGenerator/Styles/LightTheme.axaml" />
        <StyleInclude Source="avares://DocumentGenerator/Styles/SpaceHoloTheme.axaml" />
        <StyleInclude Source="avares://DocumentGenerator/Styles/AppDialogTheme.axaml" />
        <StyleInclude Source="avares://DocumentGenerator/Styles/NavChrome.axaml" />
    </Application.Styles>
</Application>