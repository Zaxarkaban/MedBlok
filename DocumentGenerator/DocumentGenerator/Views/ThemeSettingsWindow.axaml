<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocumentGenerator.ThemeSettingsWindow"
        x:Name="ThemeSettingsRoot"
        Title="Оформление"
        Width="440"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border x:Name="SettingsPanel" Margin="16" Padding="20" BorderThickness="1" CornerRadius="14">
    <Grid RowDefinitions="Auto,Auto,Auto">
      <StackPanel Grid.Row="0" Margin="0,0,0,16">
        <TextBlock x:Name="HeadingText" Text="Тема оформления" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="SubtitleText" Text="Выберите внешний вид главного меню и всех форм" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.9"/>
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="10">
        <RadioButton x:Name="RadioDefault" GroupName="Theme" Content="Базовый — тёмно-зелёный"/>
        <RadioButton x:Name="RadioColorful" GroupName="Theme" Content="Светлый — мягкие светлые тона"/>
        <RadioButton x:Name="RadioSpace" GroupName="Theme" Content="Тёмный — космическая тема"/>
      </StackPanel>
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,22,0,0">
        <Button x:Name="CancelButton" Content="Отмена" MinWidth="108" Classes="app-dialog-secondary"/>
        <Button x:Name="OkButton" Content="OK" MinWidth="108" IsDefault="True" Classes="app-dialog-primary"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
