<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DocumentGenerator.ViewModels"
        x:Class="DocumentGenerator.MenuWindow"
        Title="МедДок Генератор"
        Icon="/Assets/app-icon.png"
        Width="520" Height="720"
        MinWidth="520" MinHeight="720"
        Background="Transparent"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button:not(.theme-gear)">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Background" Value="{DynamicResource ThemeBtnNormal}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Width" Value="400"/>
      <Setter Property="MinHeight" Value="60"/>
      <Setter Property="Margin" Value="0,15"/>
      <Setter Property="CornerRadius" Value="30"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransform" Value="scale(1)"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="Black" BlurRadius="10" OffsetX="3" OffsetY="3" Opacity="0.5"/>
        </Setter.Value>
      </Setter>
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25"/>
          <BrushTransition Property="Background" Duration="0:0:0.25"/>
          <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
        </Transitions>
      </Setter>
      <Setter Property="Opacity" Value="{DynamicResource ThemeMainButtonOpacity}"/>
      <Setter Property="Template">
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  RenderTransform="{TemplateBinding RenderTransform}"
                  ClipToBounds="True"
                  Padding="10">
            <Grid>
              <Border x:Name="GlassSheen"
                      Height="22"
                      VerticalAlignment="Top"
                      CornerRadius="16,16,0,0"
                      Background="#18ffffff"
                      Margin="4,3,4,0"
                      IsHitTestVisible="False"/>
              <Ellipse x:Name="RippleEffect"
                       Width="0" Height="0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Fill="White"
                       Opacity="0">
                <Ellipse.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Width" Duration="0:0:0.45"/>
                    <DoubleTransition Property="Height" Duration="0:0:0.45"/>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.45"/>
                  </Transitions>
                </Ellipse.Transitions>
              </Ellipse>
              <ContentPresenter Content="{TemplateBinding Content}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Window.space-glass Button:not(.theme-gear)">
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeSpaceBtnBorder}"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect Color="#1e3a5c" BlurRadius="16" OffsetX="0" OffsetY="6" Opacity="0.55"/>
        </Setter.Value>
      </Setter>
    </Style>
    <Style Selector="Window.space-glass Button:not(.theme-gear):pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeSpaceBtnBorderHover}"/>
    </Style>
    <Style Selector="Button:not(.theme-gear) /template/ Border#GlassSheen">
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style Selector="Window.space-glass Button:not(.theme-gear) /template/ Border#GlassSheen">
      <Setter Property="Opacity" Value="0.2"/>
    </Style>
    <Style Selector="Button:not(.theme-gear):pointerover">
      <Setter Property="Background" Value="{DynamicResource ThemeBtnHover}"/>
      <Setter Property="RenderTransform" Value="scale(1.01)"/>
      <Setter Property="Opacity" Value="1"/>
    </Style>
    <Style Selector="Button:not(.theme-gear):pressed">
      <Setter Property="Background" Value="{DynamicResource ThemeBtnPressed}"/>
      <Setter Property="RenderTransform" Value="scale(0.98)"/>
      <Setter Property="Opacity" Value="0.8"/>
    </Style>
    <Style Selector="Image.brand-logo">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.9"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="34"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeHeaderForeground}"/>
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="MaxWidth" Value="480"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:1"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Ellipse.particle">
      <Setter Property="Fill" Value="{DynamicResource ThemeParticleFill}"/>
      <Setter Property="Opacity" Value="0.5"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:2"/>
          <DoubleTransition Property="Width" Duration="0:0:2"/>
          <DoubleTransition Property="Height" Duration="0:0:2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.theme-gear">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="46"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="14"/>
      <Setter Property="CornerRadius" Value="23"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="Background" Value="{DynamicResource ThemeGearBackground}"/>
      <Setter Property="Foreground" Value="{DynamicResource ThemeGearForeground}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource ThemeGearBorder}"/>
      <Setter Property="Opacity" Value="0.92"/>
      <Setter Property="ZIndex" Value="200"/>
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.theme-gear:pointerover">
      <Setter Property="Opacity" Value="1"/>
      <Setter Property="Background" Value="{DynamicResource ThemeGearBackgroundHover}"/>
    </Style>
  </Window.Styles>
  <Grid>
    <Border x:Name="BackgroundFillLayer" ZIndex="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border x:Name="AtmosphereLayer" ZIndex="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsHitTestVisible="False"/>
    <Canvas x:Name="ParticleCanvas" ZIndex="2" IsHitTestVisible="False"/>

    <Panel x:Name="ParallaxFarHost" ZIndex="3" ClipToBounds="True" IsHitTestVisible="False">
      <Canvas x:Name="StarsFarCanvas" IsHitTestVisible="False"/>
    </Panel>
    <Panel x:Name="ParallaxNebulaHost" ZIndex="4" ClipToBounds="True" IsHitTestVisible="False">
      <Canvas x:Name="NebulaCanvas" IsHitTestVisible="False"/>
    </Panel>
    <Panel x:Name="ParallaxDustHost" ZIndex="5" ClipToBounds="True" IsHitTestVisible="False">
      <Canvas x:Name="DustCanvas" IsHitTestVisible="False"/>
    </Panel>
    <Panel x:Name="ParallaxNearHost" ZIndex="6" ClipToBounds="False" IsHitTestVisible="False">
      <Canvas x:Name="StarsNearCanvas" IsHitTestVisible="False"/>
      <Canvas x:Name="MeteorCanvas" IsHitTestVisible="False"/>
      <Canvas x:Name="PointerTrailCanvas" IsHitTestVisible="False"/>
      <Canvas x:Name="BlackHoleCanvas" IsHitTestVisible="False"/>
    </Panel>

    <Canvas x:Name="BlackHoleMergeFxCanvas" ZIndex="9" IsHitTestVisible="False"/>

    <Grid x:Name="MenuContentGrid" ZIndex="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel x:Name="BrandHeaderPanel" Grid.Row="0" Spacing="4" HorizontalAlignment="Center" Margin="0,0,0,36">
        <Image x:Name="BrandLogo" Classes="brand-logo" Width="132" Height="132" Stretch="Uniform"/>
        <TextBlock x:Name="HeaderText" Text="МедДок Генератор" Classes="header"/>
      </StackPanel>
      <Button x:Name="NewDocumentButton" Content="Профосмотры" Grid.Row="1">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📝" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <Button x:Name="NewFormButton" Content="Водительская комиссия" Grid.Row="2">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📋" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <Button x:Name="AnalysisButton" Content="Расчет КП" Grid.Row="3">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <Button x:Name="EditorButton" Content="Конструктор" Grid.Row="4">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="✏️" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <Button x:Name="UserProgramsButton" Content="Пользовательские приложения" Grid.Row="5">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🧩" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
      <Button x:Name="ExitButton" Content="Выход" Grid.Row="6">
        <Button.ContentTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="🚪" FontSize="20" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding}" VerticalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </Button.ContentTemplate>
      </Button>
    </Grid>

    <Button x:Name="ThemeSettingsButton" Classes="theme-gear" Content="⚙" ToolTip.Tip="Оформление и темы" ZIndex="200"/>
  </Grid>
</Window>
