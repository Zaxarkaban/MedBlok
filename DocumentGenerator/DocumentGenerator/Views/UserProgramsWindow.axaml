<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DocumentGenerator.UserProgramsWindow"
        Title="Пользовательские приложения"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
	<Window.Background>
		<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
			<GradientStop Color="#04261f" Offset="0"/>
			<GradientStop Color="#0d3b31" Offset="0.5"/>
			<GradientStop Color="#04261f" Offset="1"/>
		</LinearGradientBrush>
	</Window.Background>

	<Window.Styles>
		<Style Selector="TextBlock">
			<Setter Property="Foreground" Value="#d9e1e8"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="FontFamily" Value="Segoe UI, Roboto, Arial"/>
			<Setter Property="Margin" Value="0,4,0,4"/>
		</Style>

		<Style Selector="Button">
			<Setter Property="Background">
				<Setter.Value>
					<LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
						<GradientStop Color="#2ed1b5" Offset="0"/>
						<GradientStop Color="#0a5c4e" Offset="1"/>
					</LinearGradientBrush>
				</Setter.Value>
			</Setter>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="CornerRadius" Value="18"/>
			<Setter Property="Padding" Value="12,8"/>
			<Setter Property="Margin" Value="6"/>
			<Setter Property="Opacity" Value="0.92"/>
			<Setter Property="Effect">
				<DropShadowEffect Color="Black" BlurRadius="8" OffsetX="3" OffsetY="3" Opacity="0.5"/>
			</Setter>
		</Style>
		<Style Selector="Button:pointerover">
			<Setter Property="Opacity" Value="1"/>
		</Style>

		<Style Selector="ListBox">
			<Setter Property="Background" Value="#073f36"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="BorderBrush" Value="#1f8f7a"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>

		<Style Selector="TextBox">
			<Setter Property="Background" Value="#073f36"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="BorderBrush" Value="#1f8f7a"/>
			<Setter Property="BorderThickness" Value="1"/>
		</Style>
	</Window.Styles>

	<Grid Margin="16">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<TextBlock Grid.Row="0"
				   Text="Пользовательские приложения"
				   FontSize="28"
				   FontWeight="Bold"
				   HorizontalAlignment="Center"
				   Margin="0,0,0,12"/>

		<Grid Grid.Row="1" ColumnDefinitions="2*,1*">
			<Border CornerRadius="12" Background="#1AFFFFFF" Padding="12" Margin="0,0,12,0">
				<StackPanel>
					<TextBlock Text="Список программ" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
					<ListBox Name="ProgramsListBox" Height="380"/>
					<TextBlock Name="StatusTextBlock" Text="" Margin="0,8,0,0" Opacity="0.9"/>
				</StackPanel>
			</Border>

			<Border Grid.Column="1" CornerRadius="12" Background="#1AFFFFFF" Padding="12">
				<StackPanel>
					<TextBlock Text="Действия" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
					<Button Name="CreateButton" Content="Создать"/>
					<Button Name="OpenButton" Content="Открыть"/>
					<Button Name="EditButton" Content="Редактировать"/>
					<Button Name="ExportButton" Content="Экспорт"/>
					<Button Name="ImportButton" Content="Импорт"/>
					<Button Name="DeleteButton" Content="Удалить"/>
				</StackPanel>
			</Border>
		</Grid>

		<Button Grid.Row="2"
				Name="BackToMenuButton"
				Content="Назад в главное меню"
				HorizontalAlignment="Center"
				Width="260"
				Margin="0,12,0,0"/>
	</Grid>
</Window>
